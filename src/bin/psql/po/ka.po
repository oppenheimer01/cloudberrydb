#: mainloop.c:302
#, c-format
msgid ""
"Type:  \\copyright for distribution terms\n"
"       \\h for help with SQL commands\n"
"       \\? for help with psql commands\n"
"       \\g or terminate with semicolon to execute query\n"
"       \\q to quit\n"
